POSTGRES_PASSWORD=risk_password
JWT_SECRET=replace-with-64-random-characters
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
AI_MAX_TOKENS=2048
AI_REASONING_ENABLED=false
AI_REASONING_EFFORT=high
CORS_ORIGINS=http://localhost:5173,https://localhost:8443,https://riesgo-ia.gt.local:8443

# NVIDIA NIM compatible example:
