POSTGRES_PASSWORD=risk_password
JWT_SECRET=replace-with-64-random-characters

# ================================================
# CLAVES DE LOS PROVEEDORES DE IA (solo se leen desde este archivo)
# La pagina Configuracion del sistema solo cambia MODELO y URL BASE, nunca la clave.
# - OpenAI: https://platform.openai.com/api-keys
# - NVIDIA: https://build.nvidia.com (modelos deepseek, llama, etc.)
# - Gemini: https://aistudio.google.com/apikey
# - Ollama: no requiere clave (corre local).
NVIDIA_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
AI_MAX_TOKENS=2048
AI_REASONING_ENABLED=false
AI_REASONING_EFFORT=high

# Ejemplos:
# NVIDIA: NVIDIA_API_KEY=nvapi-tu-clave-aqui
# OpenAI: OPENAI_API_KEY=sk-tu-clave-aqui
# Gemini: GEMINI_API_KEY=AIza-tu-clave-aqui
# La URL base y el modelo se eligen en la pagina Configuracion (presets).

CORS_ORIGINS=http://localhost:5173,https://localhost:8443,https://riesgo-ia.gt.local:8443

# For local development without Docker:
DATABASE_URL=postgresql+psycopg://risk_user:risk_password@localhost:5432/risk_platform
